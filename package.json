{
	"name": "pi-github-app-auth",
	"version": "0.5.1",
	"description": "Authenticate Pi agent bash commands to GitHub as a GitHub App installation, without touching your personal git/gh credentials",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"github",
		"github-app",
		"authentication",
		"git",
		"gh"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tonyputi/pi-github-app-auth.git"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"setup.ts",
		"test-live.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.2.0",
		"@types/node": "^26.6.5",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"test": "node test.ts",
		"test:live": "node test-live.ts"
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/npm",
			"@semantic-release/github"
		]
	},
	"dependencies": {
		"@octokit/auth-app": "^8.3.1"
	}
}
